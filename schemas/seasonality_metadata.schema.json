{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seasonality Metadata",
  "type": "object",
  "required": [
    "calendar_version",
    "generated_at",
    "source_archive",
    "public_species_source",
    "public_species_count",
    "calendar_species_count",
    "reconciliation_passed",
    "validation_passed",
    "expected_board_status"
  ],
  "properties": {
    "calendar_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_archive": {"type": "string"},
    "public_species_source": {"type": "string"},
    "public_species_count": {"type": "integer", "minimum": 0},
    "calendar_species_count": {"type": "integer", "minimum": 0},
    "reconciliation_passed": {"type": "boolean"},
    "missing_from_calendar": {"type": "integer", "minimum": 0},
    "unexpected_in_calendar": {"type": "integer", "minimum": 0},
    "species_with_arrivals": {"type": "integer", "minimum": 0},
    "species_with_departures": {"type": "integer", "minimum": 0},
    "resident_species": {"type": "integer", "minimum": 0},
    "scarce_irregular_species": {"type": "integer", "minimum": 0},
    "high_confidence_species": {"type": "integer", "minimum": 0},
    "medium_confidence_species": {"type": "integer", "minimum": 0},
    "low_confidence_species": {"type": "integer", "minimum": 0},
    "duplicate_species_found": {"type": "boolean"},
    "invalid_months_found": {"type": "boolean"},
    "invalid_movement_types_found": {"type": "boolean"},
    "invalid_confidence_values_found": {"type": "boolean"},
    "changes_detected": {"type": "integer", "minimum": 0},
    "arrival_changes": {"type": "integer", "minimum": 0},
    "departure_changes": {"type": "integer", "minimum": 0},
    "movement_type_changes": {"type": "integer", "minimum": 0},
    "confidence_changes": {"type": "integer", "minimum": 0},
    "methodology_version": {"type": "string"},
    "calculation_basis": {"type": "string"},
    "validation_passed": {"type": "boolean"},
    "expected_board_status": {"type": "string", "enum": ["READY", "FAILED", "INCOMPLETE"]}
  }
}
